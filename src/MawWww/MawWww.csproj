<Project Sdk="Microsoft.NET.Sdk.Web">

    <ItemGroup>
        <ProjectReference Include="..\MawWww.Blog\MawWww.Blog.csproj" />
        <ProjectReference Include="..\MawWww.Captcha\MawWww.Captcha.csproj" />
        <ProjectReference Include="..\MawWww.Email\MawWww.Email.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Fluid.Core" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
        <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
        <PackageReference Include="Microsoft.FeatureManagement.AspNetCore" />
        <PackageReference Include="NetEscapades.AspNetCore.SecurityHeaders" />
        <PackageReference Include="Npgsql" />
        <PackageReference Include="Npgsql.DependencyInjection" />
        <PackageReference Include="Npgsql.NodaTime" />
        <PackageReference Include="ZiggyCreatures.FusionCache" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="EmailTemplates\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <PropertyGroup>
        <DefaultItemExcludes>$(DefaultItemExcludes);node_modules/**;tsconfig.json;package.json</DefaultItemExcludes>
    </PropertyGroup>

    <!-- ===================================================================================== -->
    <!-- site assets: tailwind css, site.min.js, favicon.svg, and the vendored jquery scripts -->
    <!-- ===================================================================================== -->

    <!-- everything the target below reads.  the cshtml are in here because index.css imports -->
    <!-- tailwind without an @source, so tailwind scans the project for the classes it needs and -->
    <!-- a markup edit can change the emitted css -->
    <ItemGroup>
        <AssetInput Include="assets/**/*.*;package.json;bun.lockb;vite.config.ts;tsconfig.json;**/*.cshtml" Exclude="bin/**;obj/**;node_modules/**" />
        <VendorScript Include="node_modules/jquery/dist/jquery.min.js" />
        <VendorScript Include="node_modules/jquery-validation/dist/jquery.validate.min.js" />
        <VendorScript Include="node_modules/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js" />
    </ItemGroup>

    <!-- the generated files cannot be used as the target's Outputs: the tailwind cli does not -->
    <!-- rewrite index.min.css when the emitted css is unchanged, so its timestamp stays behind -->
    <!-- the inputs forever and the target never once reports as up to date.  a stamp touched at -->
    <!-- the end of the run says what we actually mean - nothing has changed since we last built. -->
    <!-- it sits in the base obj dir rather than the per-configuration one because wwwroot is -->
    <!-- shared by every configuration, so switching debug/release has nothing to rebuild -->
    <PropertyGroup>
        <AssetStamp>$(BaseIntermediateOutputPath)assets.stamp</AssetStamp>
    </PropertyGroup>

    <Target Name="Assets" Inputs="@(AssetInput)" Outputs="$(AssetStamp)">
        <Exec Command="bun install" />

        <Exec Command="bun run css:build" />
        <Exec Command="bun run ts:build" />
        <Exec Command="bun run svg:build" />

        <Copy SourceFiles="@(VendorScript)" DestinationFolder="wwwroot/js" SkipUnchangedFiles="true" />

        <Touch Files="$(AssetStamp)" AlwaysCreate="true" />
    </Target>

    <!-- ===================================================================================== -->
    <!-- client apps: each is a sibling bun/vite project whose dist is copied to wwwroot/js/<app> -->
    <!-- ===================================================================================== -->
    <ItemGroup>
        <ClientApp Include="solid-binary-clock;solid-google-maps;solid-learning;solid-memory;solid-money-spin;solid-weekend-countdown" />
        <ClientApp Include="webgl-blender-model;webgl-cube;webgl-shader;webgl-text" />
    </ItemGroup>

    <!-- the inputs are globbed here rather than at evaluation, since a glob outside a target cannot -->
    <!-- be built from each ClientApp.  the whole app dir counts (index.html, vite.config.ts, public, -->
    <!-- assets, environments all feed the build, not just src) less what the build itself writes -->
    <Target Name="_CollectClientAppInputs">
        <ItemGroup>
            <ClientAppInput Include="../%(ClientApp.Identity)/**/*" Exclude="../%(ClientApp.Identity)/node_modules/**;../%(ClientApp.Identity)/dist/**" App="%(ClientApp.Identity)" />
        </ItemGroup>
    </Target>

    <!-- batched on App, so each app is checked and rebuilt on its own.  index.html is a sound output: -->
    <!-- the dir is removed and rewritten on every run, so it is always newer than what it was built from -->
    <Target Name="BuildClientApps" DependsOnTargets="_CollectClientAppInputs" Inputs="@(ClientAppInput)" Outputs="wwwroot/js/%(ClientAppInput.App)/index.html">
        <PropertyGroup>
            <_ClientApp>%(ClientAppInput.App)</_ClientApp>
        </PropertyGroup>

        <RemoveDir Directories="wwwroot/js/$(_ClientApp)" />
        <Exec WorkingDirectory="../$(_ClientApp)" Command="bun install" />
        <Exec WorkingDirectory="../$(_ClientApp)" Command="bun run build" />

        <ItemGroup>
            <_ClientAppDist Remove="@(_ClientAppDist)" />
            <_ClientAppDist Include="../$(_ClientApp)/dist/**/*" />
        </ItemGroup>

        <Copy SourceFiles="@(_ClientAppDist)" DestinationFiles="@(_ClientAppDist->'wwwroot/js/$(_ClientApp)/%(RecursiveDir)%(Filename)%(Extension)')" />
    </Target>

    <!-- ===================================================================================== -->
    <!-- hand the generated files to static web assets -->
    <!-- ===================================================================================== -->

    <!-- static web assets builds its manifest from @(Content), and the sdk's wwwroot glob ran at -->
    <!-- evaluation - before anything above existed on a clean tree, and before a client rebuild -->
    <!-- replaced its hashed bundle names.  so drop what evaluation saw of the generated paths and -->
    <!-- glob them again now, with the metadata the sdk gives wwwroot content.  this has to run before -->
    <!-- ResolveProjectStaticWebAssets (BeforeTargets AssignTargetPaths), which BeforeBuild precedes. -->
    <!-- no FileWrites: clean only deletes recorded files under bin/obj, and these live in wwwroot -->
    <Target Name="IncludeGeneratedWebAssets" DependsOnTargets="Assets;BuildClientApps" BeforeTargets="BeforeBuild">
        <ItemGroup>
            <!-- a wildcard Remove inside a target is expanded against the disk, not matched against -->
            <!-- items, so it cannot reach a bundle the client build just deleted - drop those by hand -->
            <Content Remove="@(Content)" Condition="!Exists('%(FullPath)')" />
            <Content Remove="wwwroot/css/**;wwwroot/js/**;wwwroot/favicon.svg" />
            <Content Include="wwwroot/css/**;wwwroot/js/**;wwwroot/favicon.svg" ExcludeFromSingleFile="true" CopyToPublishDirectory="PreserveNewest" />
        </ItemGroup>
    </Target>
</Project>
