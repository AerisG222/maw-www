# gimp sources for assets whose exported png/svg are committed alongside them.
# nothing in the build reads them, and they are ~40% of the tracked context.
**/*.xcf

# generated by the csproj asset targets, and gitignored, so a fresh checkout
# never has them.  without these a local build copies in whatever the working
# tree last produced, and the Inputs/Outputs check on the client app targets
# then reports them up to date and skips the build entirely - the image ships
# the developer's stale artifacts instead of the ones the sources describe.
src/MawWww/wwwroot/css
src/MawWww/wwwroot/js
src/MawWww/wwwroot/favicon.svg
