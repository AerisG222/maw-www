[Unit]
Description=maw-www maintenance job to remotely backup database archives

[Service]
Type=oneshot
# --restart no: a container joining the kube play pod inherits its restart policy, always,
# even with --rm.  it does not loop here only because systemd stops everything left in the
# unit when podman run exits - which also stops --rm from removing it, so each run left a
# stopped, half cleaned up container behind (hence --replace), one that `podman pod
# restart` then tries and fails to start again.  with --restart no, --rm removes it
ExecStart=podman run --rm --restart no --replace --authfile {{ podman_authfile }} --pull newer --pod {{ pod }} --name {{ container_rclone }} --user 1654 --tmpfs /tmp --read-only --volume {{ dir_rcloneconf }}:/config/rclone:ro,Z --volume {{ dir_rclonesecrets }}:/secrets:ro,Z --volume {{ dir_pgbackups }}:/backups:ro,z {{ img_rclone }} -v --drive-impersonate mmorano@mikeandwan.us sync /backups gdrive:maw-www-{{ mawenv }}
